{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/lab",
      "destination": "/lab-3d/",
      "permanent": true
    },
    {
      "source": "/lab/:path*",
      "destination": "/lab-3d/:path*",
      "permanent": true
    },
    {
      "source": "/thi-nghiem",
      "destination": "/lab-2d/",
      "permanent": false
    },
    {
      "source": "/thi-nghiem.html",
      "destination": "/lab-2d/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "/api/dispatch?__route=:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/dispatch?__route=:path*"
    },
    {
      "source": "/trung-tam/tai-lieu-so/:path*/",
      "destination": "/trung-tam/index.html"
    },
    {
      "source": "/trung-tam/tai-lieu-so/:path*",
      "destination": "/trung-tam/index.html"
    },
    {
      "source": "/trung-tam/cong-dong/:path*/",
      "destination": "/trung-tam/index.html"
    },
    {
      "source": "/trung-tam/cong-dong/:path*",
      "destination": "/trung-tam/index.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/platform/chunks/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/dispatch.ts": {
      "maxDuration": 60
    }
  }
}
