{
  "name": "chemdex",
  "private": true,
  "scripts": {
    "build-pthh": "cd tien-ich/phuong-trinh/nhan-dien-pthh-thong-minh && npm ci && npm run build",
    "build-chuoi-phan-ung": "cd tien-ich/phuong-trinh/chuoi-phan-ung && npm ci && npm run build",
    "build-trung-tam": "cd trung-tam && npm ci && npm run build",
    "build-dau-truong": "cd dau-truong && npm ci && npm run build",
    "build-lab": "cd lab-3d && npm ci && npm run build",
    "build-safety": "cd lab-safety && npm ci && npm run build",
    "dev-lab": "cd lab-3d && npm run dev",
    "dev-safety": "cd lab-safety && npm run dev",
    "copy": "node scripts/build-platform.mjs --static-only",
    "build": "node scripts/build-platform.mjs",
    "build:static": "node scripts/build-platform.mjs --static-only",
    "build-lab-2d": "npm --prefix lab-2d run build",
    "test:platform": "node --test tests/platform.test.mjs tests/workspace.test.mjs",
    "test:browser": "playwright test",
    "test:preview": "node scripts/test-preview.mjs",
    "preview": "node scripts/preview.mjs",
    "lint:api": "tsc -p tsconfig.server.json",
    "catalog:build": "node scripts/build-reaction-data.mjs",
    "catalog:audit": "node scripts/audit-reaction-catalog.mjs",
    "test:reactions": "node --test tests/reaction-catalog.test.mjs tests/reaction-chain-api.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.17.0",
    "3dmol": "2.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "lighthouse": "13.5.0",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
