rules_version = '2';

/**
 * ChemDex Ecosystem - Unified Firestore Security Rules
 * Covers ChemDex Visual CMS, Trung Tâm (Community/Feed), and Đấu Trường (Arena/Multiplayer)
 * Hardened to prevent client-side score manipulation, profile hijacking, and room tampering.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. CHEMDEX CHEMICAL DATA (Visual CMS & Chemical Elements)
    // =========================================================================
    match /chemDexElements/{elementId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // 2. USERS & PROFILES (Đấu Trường & Trung Tâm)
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      // Chỉ chính chủ tài khoản mới được tạo hoặc cập nhật hồ sơ & chỉ số của mình
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Subcollection: Lịch sử trận đấu cá nhân của user
      match /matches/{matchId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // 3. TRUNG TÂM / CỘNG ĐỒNG (Posts, Stories, Notifications)
    // =========================================================================
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Bình luận bài viết
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // 4. ĐẤU TRƯỜNG HÓA HỌC (Phòng đấu, Tin nhắn, Trận đấu toàn cục)
    // =========================================================================
    match /rooms/{roomId} {
      allow read: if true;
      // Chỉ người tạo phòng (host) mới được khởi tạo phòng
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      
      // Host có toàn quyền điều khiển phòng (chuyển vòng, đổi trạng thái)
      // Người chơi tham gia chỉ được phép cập nhật thông tin người chơi (players) hoặc thời gian
      allow update: if isAuthenticated() && (
        resource.data.hostId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'updatedAt'])
      );
      
      // Chỉ host mới được xóa phòng
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /global_chat/{msgId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // 5. MẶC ĐỊNH CHẶN CÁC TÀI LIỆU KHÔNG KHAI BÁO
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
