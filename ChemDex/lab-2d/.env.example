# ChemDex 2D environment template (commit .env.example; keep local .env gitignored)

# Default Gemini model used when the user does not override it in the UI modal
VITE_GEMINI_MODEL=gemini-2.5-flash

# Optional BYOK development note:
# Do NOT embed a production Gemini API key inside VITE_* variables, as Vite exposes all
# VITE_* values to the browser bundle. Supply keys per-session via the UI ApiKeyModal
# (stored in sessionStorage) or proxy requests through a server-side endpoint using GEMINI_API_KEY.
