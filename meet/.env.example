# Server URL (Leave empty or set to production Socket.IO server URL on Render/Railway/Vercel)
VITE_SERVER_URL=http://localhost:5000

# WebRTC STUN & TURN Relay Configurations
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# Optional TURN Relay Server (For strict NATs, 4G/5G mobile data, and corporate firewalls)
VITE_TURN_SERVER=turn:openrelay.metered.ca:80
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_PASSWORD=openrelayproject
