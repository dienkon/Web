# Frontend: leave empty. /api/config discovers the backend at runtime.
# Optional override for a fixed backend; normally only REALTIME_SERVER_URL is needed on Vercel.
VITE_SERVER_URL=
# Optional: force TURN during relay verification (all is the normal mode).
VITE_ICE_TRANSPORT_POLICY=all
# VITE_STUN_SERVER=stun:stun.l.google.com:19302

# Server-only variables: set on the backend, or in server/.env.
# TURN_SERVER=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
# TURN_USERNAME=replace-on-server
# TURN_PASSWORD=replace-on-server
# Or dynamically issued credentials. Do not prefix these secrets with VITE_.
# METERED_APP_NAME=your-app
# METERED_API_KEY=your-server-api-key

# Vercel runtime environment: set to the URL of the free Render backend.
# REALTIME_SERVER_URL=https://your-realtime-server.example.com

# Render backend: generated automatically by meet/render.yaml. Keep stable across deploys.
# ROOM_SIGNING_SECRET=at-least-32-random-characters
