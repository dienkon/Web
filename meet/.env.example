# Local backend; use HTTPS Socket.IO backend URL for production.
VITE_SERVER_URL=http://localhost:5000
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# Your own TURN service for restrictive NAT/firewalls.
# VITE_* values are visible in the client bundle; prefer short-lived credentials in production.
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
