# MeetClass WebRTC & Network Traversal Configuration

# Optional: Custom STUN Server (Defaults to Google & Cloudflare STUN)
# VITE_STUN_SERVER=stun:stun.l.google.com:19302

# Optional: Production TURN Relay Server (Required for strict Symmetric NAT / 4G cellular data)
# Supported formats: turn:host:port?transport=udp, turn:host:port?transport=tcp, turns:host:port?transport=tcp
# VITE_TURN_SERVER=turn:your-turn-server.com:3478?transport=udp,turn:your-turn-server.com:3478?transport=tcp,turns:your-turn-server.com:443?transport=tcp
# VITE_TURN_USERNAME=your_username
# VITE_TURN_PASSWORD=your_password

# Or Metered.ca Turn Cloud API:
# VITE_METERED_APP_NAME=your-app
# VITE_METERED_API_KEY=your-api-key
