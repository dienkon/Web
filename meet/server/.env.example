PORT=5000
# Use a path on a persistent volume in production.
ROOM_STORE_PATH=./data/rooms.json
# TURN is required for clients behind restrictive NAT/firewalls.
# TURN_SERVER=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
# TURN_USERNAME=replace-me
# TURN_PASSWORD=replace-me
# Alternatively use server-side Metered credential generation.
# METERED_APP_NAME=your-app
# METERED_API_KEY=your-server-api-key
