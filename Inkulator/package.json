{
  "name": "scrble-math-studio",
  "version": "1.8.0",
  "private": true,
  "description": "Offline mathematical notebook for Windows and pen tablets",
  "main": "desktop/main.cjs",
  "author": "Inkulator",
  "scripts": {
    "start": "electron .",
    "desktop:build": "node scripts/build-casio.cjs && electron-builder --win nsis --x64 --publish never",
    "test:desktop": "node tests/desktop-tests.cjs",
    "test:performance": "node tests/ink-performance-tests.cjs",
    "test:geometry-pen": "node tests/geometry-pen-browser-tests.cjs",
    "test:capture-layout": "node tests/capture-layout-browser-tests.cjs",
    "test": "node tests/math-tests.cjs && node tests/construction-tests.cjs && node tests/visibility-tests.cjs",
    "test:browser": "node tests/browser-tests.cjs",
    "test:advanced": "node tests/advanced-browser-tests.cjs",
    "test:studio": "node tests/studio-browser-tests.cjs",
    "vendor:build": "node scripts/build-vendor.cjs",
    "prepackage": "node scripts/build-casio.cjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "test:pen": "node tests/pen-browser-tests.cjs",
    "test:pdf": "node tests/pdf-flow-browser-tests.cjs",
    "test:notebook": "node tests/notebook-browser-tests.cjs",
    "vendor:casio": "node scripts/build-casio.cjs",
    "test:casio": "node scripts/build-casio.cjs && node tests/casio-browser-tests.cjs"
  },
  "build": {
    "appId": "vn.inkulator.studio",
    "productName": "Inkulator",
    "artifactName": "Inkulator-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**",
      "index.html",
      "js/**",
      "css/**",
      "assets/**",
      "vendor/**",
      "examples/**",
      "package.json",
      "README.md",
      "!vendor/casio-fx580vnx/upstream/**",
      "!vendor/casio-fx580vnx/runtime/source/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "executableName": "Inkulator",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Inkulator",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "mathjax-full": "3.2.2",
    "mathjs": "15.2.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "playwright": "1.56.1"
  }
}
