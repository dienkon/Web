rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role in ['admin', 'super_admin'])
      );
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'super_admin')
      );
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Regular users cannot modify role, status, or emailVerified directly
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'emailVerified'])
      );
      allow delete: if isSuperAdmin();
    }

    // 2. Student Profiles
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isOwner(studentId) || 
        request.resource.data.uid == request.auth.uid || 
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isOwner(studentId) || 
        resource.data.uid == request.auth.uid || 
        request.resource.data.uid == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Usernames mapping
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 3. Parent Profiles
    match /parents/{parentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isOwner(parentId) || 
        request.resource.data.uid == request.auth.uid || 
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isOwner(parentId) || 
        resource.data.uid == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 4. Relationships (Parent <-> Student links)
    match /relationships/{relId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.parentUid == request.auth.uid ||
        resource.data.studentUid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.parentUid == request.auth.uid ||
        request.resource.data.studentUid == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.parentUid == request.auth.uid ||
        resource.data.studentUid == request.auth.uid
      );
    }

    // Legacy Parent Link Requests
    match /parent_link_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Exams & Subcollections (Questions, Sections)
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /sections/{sectionId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // 6. Submissions (Exam results)
    match /submissions/{subId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.studentUid == request.auth.uid ||
        request.resource.data.studentId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 7. Proctoring & Active Sessions (Operated strictly via Firebase Realtime Database - RTDB)
    // TUYỆT ĐỐI KHÔNG DÙNG FIRESTORE ĐỂ WRITE TRẠNG THÁI LIÊN TỤC
    match /active_sessions/{sessionId} {
      allow read, write: if false;
    }
    match /taking_sessions/{sessionId} {
      allow read, write: if false;
    }

    // 8. Notifications
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 9. Folders
    match /folders/{folderId} {
      allow read: if isAuthenticated() || resource.data.isPublic == true;
      allow write: if isAdmin();
    }

    // 10. Audit Logs & System Settings (Restricted to Admins)
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 11. Learning Intelligence: Learning Activities
    match /learning_activities/{actId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid ||
        request.auth.uid != null
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 12. Learning Intelligence: Revision Programs & Tasks
    match /revision_programs/{programId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid ||
        request.auth.uid != null
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid
      );
    }
    match /revision_tasks/{taskId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid ||
        request.auth.uid != null
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid
      );
    }

    // 13. Learning Intelligence: Topic Mastery & Evidence
    match /topic_mastery/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 14. Old Exams & Journey Progress
    match /student_review_mastery/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /journey_progress/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 15. Virtual Wallet & Ledgers (Phần E & B)
    match /wallets/{userId} {
      allow read, write: if true;
    }

    match /wallet_transactions/{txId} {
      allow read, write: if true;
    }

    match /deposit_requests/{reqId} {
      allow read, write: if true;
    }

    match /exam_entitlements/{entId} {
      allow read, write: if true;
    }

    match /debt_records/{recId} {
      allow read, write: if true;
    }

    // 16. System Stats
    match /system_stats/{statId} {
      allow read, write: if true;
    }

    // 17. Code Exams & Code Submissions
    match /code_exams/{examId} {
      allow read, write: if true;
    }
    match /code_submissions/{subId} {
      allow read, write: if true;
    }

    // 18. Vouchers & Voucher Usages
    match /vouchers/{voucherId} {
      allow read, write: if true;
    }
    match /voucher_usages/{usageId} {
      allow read, write: if true;
    }

    // One live share per owner/project. Only explicit publish may create/update.
    match /code_studio_shares/{shareId} {
      function validShare() {
        return shareId.matches('^[a-f0-9]{16}$')
          && request.resource.data.keys().hasOnly(['version','mode','title','description','imageUrl','payload','createdAt','updatedAt','ownerUid','projectId','slug','customSlug'])
          && request.resource.data.version == 1
          && request.resource.data.mode in ['website','website-edit','editor']
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
          && request.resource.data.description is string && request.resource.data.description.size() <= 300
          && request.resource.data.payload is string && request.resource.data.payload.size() <= 700000
          && (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() <= 2048
            && request.resource.data.imageUrl.matches('^https://res[.]cloudinary[.]com/[A-Za-z0-9_-]+/image/upload/[^ <>]+$')))
          && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40
          && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40
          && request.resource.data.projectId is string && request.resource.data.projectId.matches('^[a-zA-Z0-9_-]{1,80}$')
          && request.resource.data.slug is string && request.resource.data.slug.matches('^[a-z0-9-]{1,42}$')
          && (!('customSlug' in request.resource.data) || (request.resource.data.customSlug is string
            && request.resource.data.customSlug.matches('^[a-z0-9][a-z0-9-]{1,40}[a-z0-9]$')
            && getAfter(/databases/$(database)/documents/code_studio_names/$(request.resource.data.customSlug)).data.shareId == shareId
            && getAfter(/databases/$(database)/documents/code_studio_names/$(request.resource.data.customSlug)).data.ownerUid == request.auth.uid));
      }
      allow get: if true;
      allow list, delete: if false;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid && validShare();
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('customSlug' in resource.data) || request.resource.data.customSlug == resource.data.customSlug) && validShare();
    }
    // Unique, immutable public names. Reserve together with its owner-bound share.
    match /code_studio_names/{name} {
      allow get: if true;
      allow list, update, delete: if false;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['shareId','ownerUid','projectId','slug'])
        && name.matches('^[a-z0-9][a-z0-9-]{1,40}[a-z0-9]$')
        && !(name in ['api','admin','practice','login','assets','settings','dkcode','www'])
        && request.resource.data.slug == name
        && request.resource.data.shareId is string && request.resource.data.shareId.matches('^[a-f0-9]{16}$')
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/code_studio_shares/$(request.resource.data.shareId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/code_studio_shares/$(request.resource.data.shareId)).data.projectId == request.resource.data.projectId
        && getAfter(/databases/$(database)/documents/code_studio_shares/$(request.resource.data.shareId)).data.customSlug == name;
    }
    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
