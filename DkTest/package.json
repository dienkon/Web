{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/generate-html-template.js && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server/routes/adminRoutes.ts --bundle --platform=node --format=esm --packages=external --outfile=server/adminRoutes.bundled.js && esbuild server/routes/authRoutes.ts --bundle --platform=node --format=esm --packages=external --outfile=server/authRoutes.bundled.js && esbuild server/routes/walletRoutes.ts --bundle --platform=node --format=esm --packages=external --outfile=server/walletRoutes.bundled.js && esbuild server/routes/webImporterRoutes.ts --bundle --platform=node --format=esm --packages=external --outfile=server/webImporterRoutes.bundled.js && esbuild src/services/ai/aiRouter.ts --bundle --platform=node --format=esm --packages=external --outfile=server/aiRoutes.bundled.js && esbuild server/routes/codeStudioRoutes.ts --bundle --platform=node --format=esm --packages=external --outfile=server/codeStudioRoutes.bundled.js",
    "preview": "vite preview",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "kill:port": "powershell -Command \"Get-NetTCPConnection -LocalPort 3636 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
    "bootstrap:admin": "tsx scripts/bootstrap-super-admin.ts",
    "build:mobile": "node scripts/build-mobile.mjs",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "test:offline": "vitest run src/services/offline",
    "test:android-ui": "playwright test --config playwright.offline.config.ts",
    "check:release": "node scripts/check-release.mjs",
    "test:rules": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-rules.ps1",
    "prebuild": "npm run check:release",
    "migrate:paid-content": "tsx scripts/migrate-paid-exam-content.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/network": "^8.0.1",
    "@cortex-js/compute-engine": "^0.116.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.18.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/file-saver": "^2.0.7",
    "@types/katex": "^0.16.8",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.4.0",
    "html2pdf.js": "^0.14.0",
    "idb": "^8.0.4",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "mathjs": "^15.2.0",
    "mathlive": "^0.110.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nerdamer": "^1.1.13",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.7",
    "firebase-tools": "^15.35.0",
    "jpeg-js": "^0.4.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "jose": "4.15.9"
  }
}
