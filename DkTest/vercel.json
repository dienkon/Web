{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": {
      "includeFiles": "server/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|ico|svg|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|favicon|logo).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(zalo|facebookexternalhit|facebot|twitterbot|whatsapp|telegrambot|linkedinbot|discordbot|googlebot|bingbot|applebot).*"
        }
      ],
      "destination": "/api/social-meta?path=/$1"
    },
    {
      "source": "/voucher/:code",
      "destination": "/api/social-meta?path=/voucher/:code&voucher=:code"
    },
    {
      "source": "/vouchers/:code",
      "destination": "/api/social-meta?path=/voucher/:code&voucher=:code"
    },
    {
      "source": "/student/voucher/:code",
      "destination": "/api/social-meta?path=/voucher/:code&voucher=:code"
    },
    {
      "source": "/student/wallet",
      "destination": "/api/social-meta?path=/student/wallet"
    },
    {
      "source": "/wallet",
      "destination": "/api/social-meta?path=/student/wallet"
    },
    {
      "source": "/student/exam/:examId/result/:submissionId",
      "destination": "/api/social-meta?path=/student/exam/:examId/result/:submissionId&examId=:examId&submissionId=:submissionId"
    },
    {
      "source": "/parent/exams/:examId/submissions/:submissionId",
      "destination": "/api/social-meta?path=/parent/exams/:examId/submissions/:submissionId&examId=:examId&submissionId=:submissionId"
    },
    {
      "source": "/student/exam/:examId",
      "destination": "/api/exam-meta?examId=:examId"
    },
    {
      "source": "/exam/:examId",
      "destination": "/api/exam-meta?examId=:examId"
    },
    {
      "source": "/code-exam/:id",
      "destination": "/api/social-meta?path=/code-exam/:id&codeExamId=:id"
    },
    {
      "source": "/student/journey",
      "destination": "/api/social-meta?path=/student/journey"
    },
    {
      "source": "/journey",
      "destination": "/api/social-meta?path=/student/journey"
    },
    {
      "source": "/student/escape-room",
      "destination": "/api/social-meta?path=/student/escape-room"
    },
    {
      "source": "/escape-room",
      "destination": "/api/social-meta?path=/student/escape-room"
    },
    {
      "source": "/student/practice",
      "destination": "/api/social-meta?path=/student/practice"
    },
    {
      "source": "/practice",
      "destination": "/api/social-meta?path=/student/practice"
    },
    {
      "source": "/student/community",
      "destination": "/api/social-meta?path=/student/community"
    },
    {
      "source": "/student/ai-tutor",
      "destination": "/api/social-meta?path=/student/ai-tutor"
    },
    {
      "source": "/exams",
      "destination": "/api/social-meta?path=/exams"
    },
    {
      "source": "/api/admin/:match*",
      "destination": "/api/admin"
    },
    {
      "source": "/api/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/api/auth/:match*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/api/ai/:match*",
      "destination": "/api/ai"
    },
    {
      "source": "/api/ai",
      "destination": "/api/ai"
    },
    {
      "source": "/api/wallet/:match*",
      "destination": "/api/wallet"
    },
    {
      "source": "/api/wallet",
      "destination": "/api/wallet"
    },
    {
      "source": "/api/vouchers/:match*",
      "destination": "/api/wallet"
    },
    {
      "source": "/api/vouchers",
      "destination": "/api/wallet"
    },
    {
      "source": "/api/exams/:match*",
      "destination": "/api/wallet"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
