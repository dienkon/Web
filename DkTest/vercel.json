{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": {
      "includeFiles": "{server/**,dist/index.html,public/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|ico|svg|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/code/:slug", "destination": "/api/code-studio?slug=:slug" },
    {
      "source": "/s/:slug",
      "destination": "/api/code-studio?slug=:slug"
    },
    {
      "source": "/api/code-studio/:match*",
      "destination": "/api/code-studio?match=:match*"
    },
    {
      "source": "/((?!api/|assets/|images/|favicon|logo).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([zZ][aA][lL][oO]|[fF]acebook[eE]xternal[hH]it|[fF]acebot|[tT]witterbot|[wW]hats[aA]pp|[tT]elegram|[lL]inked[iI]n|[dD]iscord|[gG]ooglebot|[bB]ingbot|[aA]pplebot|[sS]lack|[sS]kype|line-poker).*"
        }
      ],
      "destination": "/api/social-meta?path=/$1"
    },
    {
      "source": "/voucher/([^/]+)",
      "destination": "/api/social-meta?path=/voucher/$1&voucher=$1&code=$1"
    },
    {
      "source": "/vouchers/([^/]+)",
      "destination": "/api/social-meta?path=/voucher/$1&voucher=$1&code=$1"
    },
    {
      "source": "/student/voucher/([^/]+)",
      "destination": "/api/social-meta?path=/voucher/$1&voucher=$1&code=$1"
    },
    {
      "source": "/voucher",
      "destination": "/api/social-meta?path=/voucher"
    },
    {
      "source": "/vouchers",
      "destination": "/api/social-meta?path=/voucher"
    },
    {
      "source": "/student/voucher",
      "destination": "/api/social-meta?path=/voucher"
    },
    {
      "source": "/student/wallet",
      "destination": "/api/social-meta?path=/student/wallet"
    },
    {
      "source": "/wallet",
      "destination": "/api/social-meta?path=/student/wallet"
    },
    {
      "source": "/student/exam/([^/]+)/result/([^/]+)",
      "destination": "/api/social-meta?path=/student/exam/$1/result/$2&examId=$1&submissionId=$2"
    },
    {
      "source": "/parent/exams/([^/]+)/submissions/([^/]+)",
      "destination": "/api/social-meta?path=/parent/exams/$1/submissions/$2&examId=$1&submissionId=$2"
    },
    {
      "source": "/student/exam/([^/]+)",
      "destination": "/api/exam-meta?path=/student/exam/$1&examId=$1"
    },
    {
      "source": "/exam/([^/]+)",
      "destination": "/api/exam-meta?path=/exam/$1&examId=$1"
    },
    {
      "source": "/code-exam/([^/]+)",
      "destination": "/api/social-meta?path=/code-exam/$1&codeExamId=$1"
    },
    {
      "source": "/student/journey",
      "destination": "/api/social-meta?path=/student/journey"
    },
    {
      "source": "/journey",
      "destination": "/api/social-meta?path=/student/journey"
    },
    {
      "source": "/student/escape-room",
      "destination": "/api/social-meta?path=/student/escape-room"
    },
    {
      "source": "/escape-room",
      "destination": "/api/social-meta?path=/student/escape-room"
    },
    {
      "source": "/student/practice",
      "destination": "/api/social-meta?path=/student/practice"
    },
    {
      "source": "/practice",
      "destination": "/api/social-meta?path=/student/practice"
    },
    {
      "source": "/student/community",
      "destination": "/api/social-meta?path=/student/community"
    },
    {
      "source": "/student/ai-tutor",
      "destination": "/api/social-meta?path=/student/ai-tutor"
    },
    {
      "source": "/exams",
      "destination": "/api/social-meta?path=/exams"
    },
    {
      "source": "/api/admin/:match*",
      "destination": "/api/admin"
    },
    {
      "source": "/api/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/api/auth/:match*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/api/ai/:match*",
      "destination": "/api/ai"
    },
    {
      "source": "/api/ai",
      "destination": "/api/ai"
    },
    {
      "source": "/api/wallet/:match*",
      "destination": "/api/wallet"
    },
    {
      "source": "/api/wallet",
      "destination": "/api/wallet"
    },
    {
      "source": "/api/vouchers/:match*",
      "destination": "/api/wallet"
    },
    {
      "source": "/api/vouchers",
      "destination": "/api/wallet"
    },
    {
      "source": "/api/exams/:match*",
      "destination": "/api/wallet"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
